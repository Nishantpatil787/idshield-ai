# IDShield AI — Environment Configuration Example

# Server Environment & Network Configuration
PORT=3000
NODE_ENV=development

# Gemini API Key for Multimodal Document OCR & AI Analysis
GEMINI_API_KEY=

# Biometric & Tampering Feature Toggles
ENABLE_FACE_VERIFICATION=true
ENABLE_TAMPERING_ANALYSIS=true
ENABLE_CROSS_DOC_CONSISTENCY=true
